# ==========================================
# CẤU HÌNH BẢO MẬT & TÊN MIỀN (RAILWAY / PRODUCTION)
# ==========================================
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1
FRONTEND_URL=https://your-frontend.up.railway.app

# ==========================================
# CẤU HÌNH DATABASE MYSQL (RAILWAY TỰ ĐỘNG CẤP HOẶC NHẬP THỦ CÔNG)
# ==========================================
# Railway tự động truyền các biến này khi Reference từ MySQL Service:
MYSQL_URL=
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=ta_hotel_db
MYSQLUSER=root
MYSQLPASSWORD=

