{
  "expo": {
    "name": "TA Hotel Staff",
    "slug": "ta-hotel-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tahotelstaff",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.tadanang.staff",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng TA Đà Nẵng Staff sử dụng máy ảnh để chụp ảnh hiện trường buồng phòng, sự cố kỹ thuật và tài sản thất lạc.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng TA Đà Nẵng Staff cần truy cập ảnh để nhân viên đính kèm biên bản và minh chứng xử lý.",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "package": "com.tadanang.staff",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "VIBRATE"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F59E0B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần quyền truy cập thư viện ảnh để đính kèm minh chứng.",
          "cameraPermission": "Ứng dụng cần quyền truy cập máy ảnh để chụp ảnh hiện trường."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
